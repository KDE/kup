#: kcm/backupplanwidget.cpp:385
#, kde-kuit-format
msgctxt "@info message bar appearing on top"
msgid ""
"You don't have permission to read this folder: <filename>%1</filename><nl/"
">It cannot be included in the source selection. If it does not contain "
"anything important to you, one possible solution is to exclude the folder "
"from the backup plan."
msgstr ""
"Nemate dozvolu za čitanje ove fascikle: <filename>%1</filename><nl/>Ne može "
"da se uključi u izbor izvora. Ako ne sadrži ništa što vam je važno, jedno "
"moguće rješenje je da isključite fasciklu iz plana rezerve."

#: kcm/backupplanwidget.cpp:396
#, kde-kuit-format
msgctxt "@info message bar appearing on top"
msgid ""
"You don't have permission to read this file: <filename>%1</filename><nl/>It "
"cannot be included in the source selection. If the file is not important to "
"you, one possible solution is to exclude the whole folder where the file is "
"stored from the backup plan."
msgstr ""
"Nemate dozvolu za čitanje ovog fajla: <filename>%1</filename><nl/>Ne može da "
"se uključi u izbor izvora. Ako vam fajl nije važan, jedno moguće rješenje je "
"da iz plana rezerve isključite cijelu fasciklu u kojoj se fajl nalazi."

#: kcm/backupplanwidget.cpp:412
#, kde-kuit-format
msgctxt "@info message bar appearing on top"
msgid ""
"The symbolic link <filename>%1</filename> points to a folder which is not "
"included: <filename>%2</filename>.<nl/>That is probably not what you want. "
"One solution is to simply include the target folder in the backup plan."
msgstr ""
"Simbolička veza <filename>%1</filename> pokazuje na fasciklu koja nije "
"uključena: <filename>%2</filename>.<nl/>To vjerovatno nije ono što želite. "
"Jedno rješenje je da jednostavno uključite ciljnu fasciklu u plan rezerve."

#: kcm/backupplanwidget.cpp:421
#, kde-kuit-format
msgctxt "@info message bar appearing on top"
msgid ""
"The symbolic link <filename>%1</filename> points to a file which is not "
"included: <filename>%2</filename>.<nl/>That is probably not what you want. "
"One solution is to simply include the folder where the file is stored in the "
"backup plan."
msgstr ""
"Simbolička veza <filename>%1</filename> pokazuje na fajl koji nije uključen: "
"<filename>%2</filename>.<nl/>To vjerovatno nije ono što želite. Jedno "
"rješenje je da jednostavno uključite u plan rezerve fasciklu u kojoj se fajl "
"nalazi."

#: kcm/backupplanwidget.cpp:447
#, kde-kuit-format
msgctxt "@title:window"
msgid "Select Folder"
msgstr "Izbor fascikle"

#: kcm/backupplanwidget.cpp:483
#, kde-kuit-format
msgctxt "@label"
msgid "Description:"
msgstr "Opis:"

#: kcm/backupplanwidget.cpp:485
#, kde-kuit-format
msgctxt "@action:button"
msgid "Back to overview"
msgstr "Nazad na pregled"

#: kcm/backupplanwidget.cpp:524
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Back up multiple versions over time of the files in the source folders. This "
"allows older versions of files or deleted files to be recovered.<nl/><nl/"
">The backup archive will grow in size over time, and can only be accessed "
"using the recovery tools provided by this program."
msgstr ""
"Čuva više izdanja fajlova iz izvornih fascikli tokom vremena. Tako se mogu "
"povratiti starija izdanja fajlova ili obrisani fajlovi.<nl/><nl/>Arhiva "
"rezerve vremenom raste i može joj se pristupiti samo alatkama za povraćaj "
"koje daje ovaj program."

#: kcm/backupplanwidget.cpp:536
#, kde-kuit-format
msgctxt "@option:radio"
msgid ""
"Versioned Backup (not available because <application>bup</application> is "
"not installed)"
msgstr ""
"Rezerva sa izdanjima (nije dostupna jer <application>bup</application> nije "
"instaliran)"

#: kcm/backupplanwidget.cpp:541
#, kde-kuit-format
msgctxt "@option:radio"
msgid "Versioned Backup (recommended)"
msgstr "Rezerva sa izdanjima (preporučena)"

#: kcm/backupplanwidget.cpp:546
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Make the destination folder identical to the source folder. Files deleted "
"from a source folder will be deleted from the backup folder as well.<nl/><nl/"
">This can prevent data loss due to a broken disk, but not due to files being "
"accidentally deleted or changed."
msgstr ""
"Čini odredišnu fasciklu istovjetnom izvornoj. Fajlovi obrisani iz izvorne "
"fascikle biće obrisani i iz fascikle rezerve.<nl/><nl/>Ovo može spriječiti "
"gubitak podataka zbog pokvarenog diska, ali ne i zbog fajlova koji su "
"slučajno obrisani ili izmijenjeni."

#: kcm/backupplanwidget.cpp:558
#, kde-kuit-format
msgctxt "@option:radio"
msgid ""
"Synchronized Backup (not available because <application>rsync</application> "
"is not installed)"
msgstr ""
"Sinhronizovana rezerva (nije dostupna jer <application>rsync</application> "
"nije instaliran)"

#: kcm/backupplanwidget.cpp:563
#, kde-kuit-format
msgctxt "@option:radio"
msgid "Synchronized Backup"
msgstr "Sinhronizovana rezerva"

#: kcm/backupplanwidget.cpp:591
#, kde-kuit-format
msgctxt "@title"
msgid "Backup Type"
msgstr "Tip rezerve"

#: kcm/backupplanwidget.cpp:592
#, kde-kuit-format
msgctxt "@label"
msgid "Select what type of backup you want"
msgstr "Izaberite koji tip rezerve želite"

#: kcm/backupplanwidget.cpp:608
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Some files and folders (such as caches or encrypted folders) are "
"automatically excluded. You can configure this in the "
"<interface><link>Advanced</link></interface> settings."
msgstr ""
"Neki fajlovi i fascikle (poput keševa ili šifrovanih fascikli) automatski se "
"isključuju. To možete podesiti u postavkama <interface><link>Napredno</"
"link></interface>."

#: kcm/backupplanwidget.cpp:619
#, kde-kuit-format
msgctxt "@title"
msgid "Sources"
msgstr "Izvori"

#: kcm/backupplanwidget.cpp:620
#, kde-kuit-format
msgctxt "@label"
msgid "Select which folders to include in backup"
msgstr "Izaberite koje fascikle da se uključe u rezervu"

#: kcm/backupplanwidget.cpp:635
#, kde-kuit-format
msgctxt "@option:radio"
msgid "Filesystem Path"
msgstr "Putanja u fajl sistemu"

#: kcm/backupplanwidget.cpp:636
#, kde-kuit-format
msgctxt "@option:radio"
msgid "External Storage"
msgstr "Spoljašnje skladište"

#: kcm/backupplanwidget.cpp:642
#, kde-kuit-format
msgctxt "@info"
msgid ""
"You can use this option for backing up to a secondary internal harddrive, an "
"external eSATA drive or networked storage. The requirement is just that you "
"always mount it at the same path in the filesystem. The path specified here "
"does not need to exist at all times, its existence will be monitored."
msgstr ""
"Ovu opciju možete koristiti za rezerve na drugi unutrašnji čvrsti disk, "
"spoljašnju eSATA jedinicu ili mrežno skladište. Jedini uslov je da ga uvijek "
"montirate na istu putanju u fajl sistemu. Ovdje zadata putanja ne mora "
"stalno da postoji, njeno postojanje će se nadgledati."

#: kcm/backupplanwidget.cpp:649
#, kde-kuit-format
msgctxt "@label:textbox"
msgid "Destination Path for Backup:"
msgstr "Odredišna putanja za rezervu:"

#: kcm/backupplanwidget.cpp:660
#, kde-kuit-format
msgctxt "@info message bar near text edit"
msgid "Only local filesystem paths will work!"
msgstr "Radiće samo putanje u lokalnom fajl sistemu!"

#: kcm/backupplanwidget.cpp:667
#, kde-kuit-format
msgctxt "@info message bar near text edit"
msgid "Folder does not exist! No backups will be saved until you create it."
msgstr ""
"Fascikla ne postoji! Nijedna rezerva neće biti sačuvana dok je ne napravite."

#: kcm/backupplanwidget.cpp:686
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Use this option if you want to backup your files on an external storage that "
"can be plugged in to this computer, such as a USB hard drive or memory stick."
msgstr ""
"Koristite ovu opciju ako želite rezerve fajlova na spoljašnjem skladištu "
"koje može da se priključi na ovaj računar, poput USB čvrstog diska ili "
"memorijskog štapića."

#: kcm/backupplanwidget.cpp:695 kcm/backupplanwidget.cpp:698
#, kde-kuit-format
msgctxt "@info:tooltip"
msgid "The specified folder will be created if it does not exist."
msgstr "Zadata fascikla će biti napravljena ako ne postoji."

#: kcm/backupplanwidget.cpp:697
#, kde-kuit-format
msgctxt "@label:textbox"
msgid "Folder on Destination Drive:"
msgstr "Fascikla na odredišnoj jedinici:"

#: kcm/backupplanwidget.cpp:704
#, kde-kuit-format
msgctxt "@info:tooltip"
msgid "Open dialog to select a folder"
msgstr "Otvori dijalog za izbor fascikle"

#: kcm/backupplanwidget.cpp:734
#, kde-kuit-format
msgctxt "@title"
msgid "Destination"
msgstr "Odredište"

#: kcm/backupplanwidget.cpp:735
#, kde-kuit-format
msgctxt "@label"
msgid "Select the backup destination"
msgstr "Izaberite odredište rezerve"

#: kcm/backupplanwidget.cpp:753
#, kde-kuit-format
msgctxt "@option:radio"
msgid "Manual Activation"
msgstr "Ručno pokretanje"

#: kcm/backupplanwidget.cpp:754
#, kde-kuit-format
msgctxt "@option:radio"
msgid "Interval"
msgstr "Period"

#: kcm/backupplanwidget.cpp:755
#, kde-kuit-format
msgctxt "@option:radio"
msgid "Active Usage Time"
msgstr "Vrijeme aktivne upotrebe"

#: kcm/backupplanwidget.cpp:758
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Backups are only saved when manually requested. This can be done by using "
"the Backup Status plasma widget."
msgstr ""
"Rezerve se upisuju samo na ručni zahtjev. To može da se uradi pomoću plasma "
"vidžeta „Stanje rezerve“."

#: kcm/backupplanwidget.cpp:773
#, kde-kuit-format
msgctxt "@info"
msgid ""
"New backup will be triggered when backup destination becomes available and "
"more than the configured interval has passed since the last backup was saved."
msgstr ""
"Nova rezerva će biti pokrenuta kada odredište rezerve postane dostupno i "
"kada od posljednje sačuvane rezerve prođe više od podešenog perioda."

#: kcm/backupplanwidget.cpp:790
#, kde-kuit-format
msgctxt "@item:inlistbox"
msgid "Minutes"
msgstr "minuta"

#: kcm/backupplanwidget.cpp:791 kcm/backupplanwidget.cpp:818
#, kde-kuit-format
msgctxt "@item:inlistbox"
msgid "Hours"
msgstr "sati"

#: kcm/backupplanwidget.cpp:792
#, kde-kuit-format
msgctxt "@item:inlistbox"
msgid "Days"
msgstr "dana"

#: kcm/backupplanwidget.cpp:793
#, kde-kuit-format
msgctxt "@item:inlistbox"
msgid "Weeks"
msgstr "sedmica"

#: kcm/backupplanwidget.cpp:803
#, kde-kuit-format
msgctxt "@info"
msgid ""
"New backup will be triggered when backup destination becomes available and "
"you have been using your computer actively for more than the configured time "
"limit since the last backup was saved."
msgstr ""
"Nova rezerva će biti pokrenuta kada odredište rezerve postane dostupno i "
"kada od posljednje sačuvane rezerve računar aktivno koristite duže od "
"podešenog vremenskog ograničenja."

#: kcm/backupplanwidget.cpp:823
#, kde-kuit-format
msgctxt "@option:check"
msgid "Ask for confirmation before saving backup"
msgstr "Traži potvrdu prije upisivanja rezerve"

#: kcm/backupplanwidget.cpp:842
#, kde-kuit-format
msgctxt "@title"
msgid "Schedule"
msgstr "Raspored"

#: kcm/backupplanwidget.cpp:843
#, kde-kuit-format
msgctxt "@label"
msgid "Specify the backup schedule"
msgstr "Zadajte raspored rezervi"

#: kcm/backupplanwidget.cpp:881
#, kde-kuit-format
msgctxt "@option:check"
msgid "Show hidden folders in source selection"
msgstr "Prikaži skrivene fascikle u izboru izvora"

#: kcm/backupplanwidget.cpp:883
#, kde-kuit-format
msgctxt "@info"
msgid ""
"This makes it possible to explicitly include or exclude hidden folders in "
"the backup source selection. Hidden folders have a name that starts with a "
"dot. They are typically located in your home folder and are used to store "
"settings and temporary files for your applications."
msgstr ""
"Ovo omogućava da izričito uključite ili isključite skrivene fascikle u "
"izboru izvora rezerve. Skrivene fascikle imaju ime koje počinje tačkom. "
"Obično se nalaze u vašoj domaćoj fascikli i služe za čuvanje postavki i "
"privremenih fajlova vaših programa."

#: kcm/backupplanwidget.cpp:895
#, kde-kuit-format
msgctxt "@info"
msgid ""
"This will make your backups use around 10% more storage space and saving "
"backups will take slightly longer time. In return it will be possible to "
"recover from a partially corrupted backup."
msgstr ""
"Zbog ovoga će vaše rezerve zauzimati oko 10% više prostora za skladištenje, "
"a upisivanje rezervi trajaće nešto duže. Zauzvrat će biti moguće povratiti "
"podatke iz djelimično iskvarene rezerve."

#: kcm/backupplanwidget.cpp:903
#, kde-kuit-format
msgctxt "@option:check"
msgid "Generate recovery information"
msgstr "Pravi podatke za povraćaj"

#: kcm/backupplanwidget.cpp:906
#, kde-kuit-format
msgctxt "@option:check"
msgid ""
"Generate recovery information (not available because <application>par2</"
"application> is not installed)"
msgstr ""
"Pravi podatke za povraćaj (nije dostupno jer <application>par2</application> "
"nije instaliran)"

#: kcm/backupplanwidget.cpp:913
#, kde-kuit-format
msgctxt "@option:check"
msgid "Verify integrity of backups"
msgstr "Provjeravaj cjelovitost rezervi"

#: kcm/backupplanwidget.cpp:915
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Checks the whole backup archive for corruption every time you save new data. "
"Saving backups will take a little bit longer time but it allows you to catch "
"corruption problems sooner than at the time you need to use a backup, at "
"that time it could be too late."
msgstr ""
"Provjerava da li je cijela arhiva rezerve iskvarena svaki put kada sačuvate "
"nove podatke. Upisivanje rezervi trajaće malo duže, ali ćete probleme "
"iskvarenja uočiti ranije nego u trenutku kada vam rezerva zatreba, kada bi "
"moglo biti kasno."

#: kcm/backupplanwidget.cpp:926
#, kde-kuit-format
msgctxt "@option:check"
msgid "Exclude files and folders based on patterns"
msgstr "Isključi fajlove i fascikle po obrascima"

#: kcm/backupplanwidget.cpp:943
#, kde-format
msgctxt "manual as in 'documentation'"
msgid "bup-index manual"
msgstr "priručnik za bup-index"

#: kcm/backupplanwidget.cpp:943
#, kde-format
msgctxt "manual as in 'documentation'"
msgid "rsync manual"
msgstr "priručnik za rsync"

#: kcm/backupplanwidget.cpp:945
#, kde-kuit-format
msgctxt "@info %2 is either 'bup-index manual' or 'rsync manual'"
msgid ""
"Patterns need to be listed in a text file with one pattern per line. Files "
"and folders with names that match any of the patterns will be excluded from "
"the backup. The pattern format is documented in the <link url='%1'>%2</link>."
msgstr ""
"Obrasci moraju biti navedeni u tekstualnom fajlu, po jedan obrazac u redu. "
"Fajlovi i fascikle čija imena odgovaraju bilo kom obrascu biće isključeni iz "
"rezerve. Format obrazaca opisan je u dokumentu „<link url='%1'>%2</link>“."

#: kcm/backupplanwidget.cpp:965
#, kde-kuit-format
msgctxt "@info:tooltip"
msgid "Open dialog to select a file"
msgstr "Otvori dijalog za izbor fajla"

#: kcm/backupplanwidget.cpp:967
#, kde-format
msgid "Select pattern file"
msgstr "Izbor fajla obrazaca"

#: kcm/backupplanwidget.cpp:985
#, kde-kuit-format
msgctxt "@option:check"
msgid "Exclude caches"
msgstr "Isključi keševe"

#: kcm/backupplanwidget.cpp:986
#, kde-kuit-format
msgctxt "@info"
msgid "Temporary data that can be recreated"
msgstr "Privremeni podaci koji mogu ponovo da se stvore"

#: kcm/backupplanwidget.cpp:995
#, kde-kuit-format
msgctxt "@option:check"
msgid "Exclude encrypted folders"
msgstr "Isključi šifrovane fascikle"

#: kcm/backupplanwidget.cpp:996
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Contents of unlocked encrypted folders, such as those created with Plasma "
"Vault"
msgstr ""
"Sadržaj otključanih šifrovanih fascikli, poput onih napravljenih plasma "
"trezorom"

#: kcm/backupplanwidget.cpp:1004
#, kde-kuit-format
msgctxt "@option:check"
msgid "Exclude trash"
msgstr "Isključi smeće"

#: kcm/backupplanwidget.cpp:1005
#, kde-kuit-format
msgctxt "@info"
msgid "Files in trash that have not been permanently deleted"
msgstr "Fajlovi u smeću koji nisu trajno obrisani"

#: kcm/backupplanwidget.cpp:1014
#, kde-kuit-format
msgctxt "@option:check"
msgid "Exclude app states"
msgstr "Isključi stanja programa"

#: kcm/backupplanwidget.cpp:1015
#, kde-kuit-format
msgctxt "@info"
msgid ""
"App-specific state data, such as window position, history, and open files"
msgstr ""
"Podaci o stanju pojedinih programa, poput položaja prozora, istorijata i "
"otvorenih fajlova"

#: kcm/backupplanwidget.cpp:1024
#, kde-kuit-format
msgctxt "@option:check"
msgid "Exclude containers and virtual machine images"
msgstr "Isključi kontejnere i odraze virtuelnih mašina"

#: kcm/backupplanwidget.cpp:1025
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Containers or virtual machine images, such as those created by GNOME Boxes, "
"Docker, Podman, and Incus"
msgstr ""
"Kontejneri ili odrazi virtuelnih mašina, poput onih napravljenih pomoću "
"GNOME Boxes, Docker, Podman i Incus"

#: kcm/backupplanwidget.cpp:1033
#, kde-kuit-format
msgctxt "@option:check"
msgid "Exclude snapshots"
msgstr "Isključi snimke"

#: kcm/backupplanwidget.cpp:1034
#, kde-kuit-format
msgctxt "@info"
msgid "Btrfs filesystem snapshots"
msgstr "Snimci btrfs fajl sistema"

#: kcm/backupplanwidget.cpp:1044
#, kde-kuit-format
msgctxt "@option:check"
msgid "Exclude user-level Flatpaks"
msgstr "Isključi korisničke Flatpak pakete"

#: kcm/backupplanwidget.cpp:1045
#, kde-kuit-format
msgctxt "@info"
msgid ""
"Flatpak apps and runtimes that can be re-downloaded (will not prevent "
"backing up settings and data for these apps)"
msgstr ""
"Flatpak programi i izvršna okruženja koja mogu ponovo da se preuzmu (ne "
"sprječava rezerve postavki i podataka ovih programa)"

#: kcm/backupplanwidget.cpp:1067
#, kde-kuit-format
msgctxt "@title"
msgid "Advanced"
msgstr "Napredno"

#: kcm/backupplanwidget.cpp:1068
#, kde-kuit-format
msgctxt "@label"
msgid "Extra options for advanced users"
msgstr "Dodatne opcije za napredne korisnike"

#: kcm/backupplanwidget.cpp:1098
#, kde-kuit-format
msgctxt "@action:button"
msgid "Create Folder"
msgstr "Napravi fasciklu"

#: kcm/driveselection.cpp:267
#, kde-kuit-format
msgctxt "@label Only shown if no drives are detected"
msgid ""
"Plug in the external storage you wish to use, then select it in this list."
msgstr ""
"Priključite spoljašnje skladište koje želite da koristite, pa ga izaberite "
"na ovom spisku."

#: kcm/driveselectiondelegate.cpp:69
#, kde-kuit-format
msgctxt "@item:inlistbox this text is added if selected drive is disconnected"
msgid " (disconnected)"
msgstr " (nepovezano)"

#: kcm/driveselectiondelegate.cpp:73
#, kde-kuit-format
msgctxt "@label %1 is amount of free storage space of hard drive"
msgid "%1 free"
msgstr "%1 slobodno"

#: kcm/driveselectiondelegate.cpp:89
#, kde-kuit-format
msgctxt ""
"@item:inlistbox used for unnamed filesystems, more than one filesystem on "
"device. %1 is partition number, %2 is device description, %3 is either empty "
"or the \" (disconnected)\" text"
msgid "Partition %1 on %2%3"
msgstr "particija %1 na %2%3"

#: kcm/driveselectiondelegate.cpp:97
#, kde-kuit-format
msgctxt ""
"@item:inlistbox used when there is only one unnamed filesystem on device. %1 "
"is device description, %2 is either empty or the \" (disconnected)\" text"
msgid "%1%2"
msgstr "%1%2"

#: kcm/driveselectiondelegate.cpp:103
#, kde-kuit-format
msgctxt ""
"@item:inlistbox %1 is filesystem label, %2 is the device description, %3 is "
"either empty or the \" (disconnected)\" text"
msgid "%1 on %2%3"
msgstr "%1 na %2%3"

#: kcm/driveselectiondelegate.cpp:113
#, kde-kuit-format
msgctxt "@item:inlistbox %1 is drive(partition) label, %2 is storage capacity"
msgid "%1: %2 total capacity"
msgstr "%1: ukupni kapacitet %2"

#: kcm/driveselectiondelegate.cpp:168
#, kde-kuit-format
msgctxt "@item:inlistbox"
msgid ""
"Warning: Symbolic links and file permissions can not be saved to this file "
"system. File permissions only matters if there is more than one user of this "
"computer or if you are backing up executable program files."
msgstr ""
"upozorenje: simboličke veze i dozvole fajlova ne mogu da se sačuvaju na ovom "
