#: daemon/buprepairjob.cpp:70
#, kde-kuit-format
msgctxt "@info notification"
msgid ""
"Backup repair failed. Your backups could be corrupted! See log file for more "
"details."
msgstr ""
"Oprava zálohy zlyhala. Vaše zálohy môžu byť poškodené! Podrobnosti nájdete v "
"súbore denníka."

#: daemon/buprepairjob.cpp:74
#, kde-kuit-format
msgctxt "@info notification"
msgid "Success! Backup repair worked. See log file for more details."
msgstr ""
"Úspech! Oprava zálohy sa podarila. Podrobnosti nájdete v súbore denníka."

#: daemon/buprepairjob.cpp:82
#, kde-kuit-format
msgctxt "@info notification"
msgid ""
"Backup repair was not necessary. Your backups are not corrupted. See log "
"file for more details."
