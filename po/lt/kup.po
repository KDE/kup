#: daemon/buprepairjob.cpp:70
#, kde-kuit-format
msgctxt "@info notification"
msgid ""
"Backup repair failed. Your backups could be corrupted! See log file for more "
"details."
msgstr ""
"Nepavyko pataisyti atsarginės kopijos. Atsarginės kopijos gali būti "
"sugadintos! Išsamesnės informacijos ieškokite žurnalo faile."

#: daemon/buprepairjob.cpp:74
#, kde-kuit-format
