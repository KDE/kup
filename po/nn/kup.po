#: kcm/driveselectiondelegate.cpp:168
#, kde-kuit-format
msgctxt "@item:inlistbox"
msgid ""
"Warning: Symbolic links and file permissions can not be saved to this file "
"system. File permissions only matters if there is more than one user of this "
"computer or if you are backing up executable program files."
msgstr ""
"Åtvaring: Symbolske lenkjer og filløyve kan ikkje lagrast til dette "
"filsystemet. Filløyve er berre viktige dersom det er fleire brukarar på "
"maskina eller viss du tek reservekopiar av køyrbare programfiler."

#: kcm/driveselectiondelegate.cpp:174
#, kde-kuit-format
msgctxt "@item:inlistbox"
msgid ""
"Warning: File permissions can not be saved to this file system. File "
"permissions only matters if there is more than one user of this computer or "
"if you are backing up executable program files."
msgstr ""
"Åtvaring: Filløyve kan ikkje lagrast til dette filsystemet. Filløyve er "
"berre viktige dersom det er fleire brukarar på maskina eller viss du tek "
"reservekopiar av køyrbare programfiler."

#: kcm/folderselectionmodel.cpp:94
#, kde-kuit-format
msgctxt "@info:tooltip %1 is the path of the folder in a listview"
msgid ""
"<filename>%1</filename><nl/>will be included in the backup, except for "
"unchecked subfolders"
msgstr ""
"<filename>%1</filename><nl/>vert teken med i reservekopien, med unntak av "
"undermapper du har kryssa vekk"

#: kcm/folderselectionmodel.cpp:99
#, kde-kuit-format
msgctxt "@info:tooltip %1 is the path of the folder in a listview"
